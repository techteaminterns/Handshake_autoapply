{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es2015", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "api/**/*",
    "*.js"
  ],
  "exclude": [
    "src/frontend",
    "node_modules"
  ]
}
